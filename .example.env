# Flask Configuration
FLASK_ENV=production
FLASK_BASE_URL=http://localhost:5000

# MongoDB Configuration
MONGO_URI=mongodb://admin:password@db:27017/database_name?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password

# Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend Configuration
VUE_FRONT_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:5000
VITE_BACKEND_WS=ws://localhost:5000
NODE_ENV=development

# Email Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_DEFAULT_SENDER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# Security
SECRET_KEY=your_secret_key_here_use_a_strong_random_string

# Google Drive
ID_ROOT_FOLDER_GDRIVE=your_google_drive_folder_id
