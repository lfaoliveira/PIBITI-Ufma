# python3.8-slim (debian-based) - Legacy stack compatible
FROM python:3.8-slim-bullseye AS builder

# Set environment variables to avoid user prompts during installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PROJECT_ENVIRONMENT=/opt/venv


WORKDIR /flask_backend

# Install dependencies and clean up
RUN --mount=type=cache,id=global-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=global-apt-lib,target=/var/lib/apt,sharing=locked \
 apt-get update -y && apt-get install -y --no-install-recommends \
    ffmpeg \
    bash \
    gcc \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    python3-pip python3-cffi python3-brotli libpango-1.0-0 libpangoft2-1.0-0  
    # && apt-get clean && rm -rf /var/lib/apt/lists/*
    
# RUN python3 -m venv /opt/venv  
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip && pip install uv

# Copy requirements and install Python dependencies
COPY flask_backend/pyproject.toml flask_backend/.python-version ./

# RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .
RUN --mount=type=cache,id=global-uv-cache,target=/root/.cache/uv,sharing=locked \
    uv sync


FROM python:3.8-slim-bullseye AS runner_flask

WORKDIR /app

# VOLUME ["/flask_backend"]
# Copy the virtualenv from builder
COPY --from=builder /opt/venv /opt/venv  
ENV PATH="/opt/venv/bin:$PATH"
# Copy only necessary files from the builder stage
# Reinstall only runtime libs (no gcc, no weasyprint build deps)
RUN --mount=type=cache,id=global-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=global-apt-lib,target=/var/lib/apt,sharing=locked \ 
    apt-get update -y \
    && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    curl \
    libxext6 \
    libgl1-mesa-glx \
    python3-pip python3-cffi python3-brotli libpango-1.0-0 libpangoft2-1.0-0 
    # && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy application files
COPY ./flask_backend ./.env ./flask_backend/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# COPY ./.env ./

ENV PYTHONPATH=/app:$PYTHONPATH


# Smoke test: Validar que imports críticos funcionam
RUN python ./flask_backend/validate_imports.py

EXPOSE 5000

# Health check para validar que Flask está rodando
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=60s \
    CMD curl -f http://localhost:5000/api || exit 1
