# python3.8-slim (debian-based) - Legacy stack compatible
FROM python:3.9-slim-bullseye AS builder

# Set environment variables to avoid user prompts during installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy
ENV PATH="/opt/venv/bin:$PATH"


WORKDIR /flask_backend

# Install dependencies and clean up
# RUN apt-get update -y && apt-get install -y --no-install-recommends \
#     ffmpeg \
#     gcc \
#     libsm6 \
#     libxext6 \
#     libgl1-mesa-glx \
#     python3-pip python3-cffi python3-brotli libpango-1.0-0 libpangoft2-1.0-0 \
#     && apt-get clean && rm -rf /var/lib/apt/lists/*

# RUN python3 -m venv /opt/venv  
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /uvx /bin/

# Copy requirements and install Python dependencies
COPY flask_backend/pyproject.toml flask_backend/uv.lock flask_backend/.python-version ./

RUN uv sync --frozen --no-dev \
    && find /opt/venv -type f -name "*.pyo" -delete \
    && find /opt/venv -type d -name "__pycache__" -prune -exec rm -rf '{}' + 


FROM python:3.9-slim-bullseye AS runner_flask

WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app:$PYTHONPATH
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Copy the virtualenv from builder
COPY --from=builder /opt/venv /opt/venv  
# Copy only necessary files from the builder stage
# Reinstall only runtime libs (no gcc, no weasyprint build deps)
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    bash \
    libxext6 \
    libgl1-mesa-glx \
    python3-cffi python3-brotli libpango-1.0-0 libpangoft2-1.0-0 \
    && apt-get clean \
    && rm -rf /var/log/* /var/log/apt/* /var/lib/dpkg/info/* /var/lib/apt/lists/* /var/cache/apt/archives/* /var/cache/apt/archives/partial \
    && rm -rf /usr/share/doc /usr/share/info /usr/share/man /usr/share/locale

# Copy application files
COPY ./flask_backend ./.env ./flask_backend/




# Smoke test: Validar que imports críticos funcionam
#NOTE: COMENTADO PARA NAO AUMENTAR BUILD!!
# RUN python ./flask_backend/validate_imports.py


EXPOSE 5000