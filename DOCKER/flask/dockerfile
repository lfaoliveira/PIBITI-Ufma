# Use a smaller base image
FROM python:3.9-slim AS builder

# Set environment variables to avoid user prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /FLASK

# Install dependencies and clean up
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    bash \
    weasyprint \
    gcc \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    python3-pip libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 libjpeg-dev libopenjp2-7-dev libffi-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN ls -l /usr/lib/x86_64-linux-gnu/libGL.so.1

# Copy requirements and install Python dependencies
COPY FLASK/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY ./FLASK ./
COPY ./env.csv ./

# Final stage
FROM python:3.9-slim AS runner_flask

WORKDIR /FLASK

# VOLUME ["/FLASK"]
# Copy only necessary files from the builder stage
COPY --from=builder /FLASK /FLASK

# Verify required files exist
RUN test -f ./permalink-googleDrive-pibiti6-nervo.json || (echo "permalink-googleDrive-pibiti6-nervo.json file not found in FLASK directory" && exit 1)
RUN test -f ./env.csv || (echo "env.csv file not found in FLASK directory" && exit 1)

# Copy installed Python dependencies from builder stage to runner stage
COPY --from=builder /usr/local/lib/python3.9/site-packages /usr/local/lib/python3.9/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

EXPOSE 5000
CMD ["python", "-m", "server"]